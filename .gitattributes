* text=auto eol=lf

# Treat docs as text
docs/** linguist-generated=false

# Normalize shell scripts
*.sh text eol=lf

# The icon assets are binary: the packaging writes the same bytes on every
# platform, and a line-ending rewrite would corrupt them.
*.png binary
*.ico binary
*.icns binary

# The recorded parity corpus is gzip: a line-ending rewrite would corrupt it, and
# the golden gate compares the ports against the bytes it writes.
*.gz binary

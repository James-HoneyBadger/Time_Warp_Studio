// SPDX-License-Identifier: MIT
//
// The Windows resource for the IDE: the icon Explorer draws and the version
// block the file's Properties dialog shows. Configured by native/CMakeLists.txt,
// which substitutes the icon path and the four numeric version fields from the
// repository's VERSION file -- the same file the window title and the packages
// read, so none of the three can drift.

#include <windows.h>

IDI_ICON1 ICON "@TIME_WARP_ICON_ICO@"

VS_VERSION_INFO VERSIONINFO
    FILEVERSION @TIME_WARP_VERSION_COMMA@
    PRODUCTVERSION @TIME_WARP_VERSION_COMMA@
    FILEFLAGSMASK 0x3fL
    FILEFLAGS 0x0L
    FILEOS VOS_NT_WINDOWS32
    FILETYPE VFT_APP
    FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "James Temple"
            VALUE "FileDescription", "Time Warp Studio"
            VALUE "FileVersion", "@TIME_WARP_VERSION_DOTTED@"
            VALUE "InternalName", "time_warp_ide"
            VALUE "LegalCopyright", "MIT licensed. James Temple."
            VALUE "OriginalFilename", "time_warp_ide.exe"
            VALUE "ProductName", "Time Warp Studio"
            VALUE "ProductVersion", "@TIME_WARP_VERSION_DOTTED@"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END

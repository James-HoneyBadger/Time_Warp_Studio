[Desktop Entry]
Type=Application
# The version of the Desktop Entry specification, not the product version. This stays
# 1.0; the product version lives in the repository's VERSION file and reaches the
# application through CMake.
Version=1.0
Name=Time Warp Studio
GenericName=Educational Programming Environment
Comment=Learn BASIC, APL, Logo, PILOT, FOCAL, Scheme, CHIP-8, COMAL, REXX and Smalltalk in one IDE
Exec=time_warp_ide %F
TryExec=time_warp_ide
Icon=time-warp-studio
Terminal=false
Categories=Development;Education;IDE;
Keywords=basic;apl;logo;pilot;focal;scheme;chip8;comal;rexx;smalltalk;turtle;graphics;education;teaching;
StartupNotify=true
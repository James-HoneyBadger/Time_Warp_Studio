10 REM DATA, READ and arrays in COMAL
20 DIM SCORES(5)
30 DATA 12, 47, 31, 8, 25
40 FOR I := 1 TO 5
50 READ SCORES(I)
60 NEXT I
70 TOTAL := 0
80 BEST := SCORES(1)
90 FOR I := 1 TO 5
100 TOTAL := TOTAL + SCORES(I)
110 IF SCORES(I) > BEST THEN
120 BEST := SCORES(I)
130 ENDIF
140 NEXT I
150 PRINT "Total: ", TOTAL
160 PRINT "Best : ", BEST
170 PRINT "Mean : ", TOTAL / 5

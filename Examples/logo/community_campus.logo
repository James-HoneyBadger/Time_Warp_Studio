; COMMUNITY CAMPUS MAP | LOGO TURTLE STUDIO
; Draws a small campus garden and learning plaza as one scene.

TO SQUARE :SIZE
  REPEAT 4 [FORWARD :SIZE RIGHT 90]
END

TO HEXAGON :SIZE
  REPEAT 6 [FORWARD :SIZE RIGHT 60]
END

TO FLOWER :SIZE
  REPEAT 12 [FORWARD :SIZE RIGHT 150]
END

TO TREE :SIZE
  REPEAT 36 [FORWARD :SIZE RIGHT 10]
END

TO PATH :LENGTH
  SETPENCOLOR 150 110 70
  SETPENWIDTH 5
  FORWARD :LENGTH
  SETPENWIDTH 1
END

TO GARDEN_BED :SIZE
  SETPENCOLOR 50 150 85
  SQUARE :SIZE
  PENUP
  FORWARD (:SIZE / 2)
  PENDOWN
  SETPENCOLOR 250 185 45
  FLOWER (:SIZE / 8)
  PENUP
  BACK (:SIZE / 2)
  PENDOWN
END

PRINT "COMMUNITY CAMPUS MAP"
PRINT "A turtle drawn tour of the learning plaza"

CLEARSCREEN
HOME
SETPENCOLOR 90 105 125
SETPENWIDTH 2
PENUP
SETXY -150 -110
PENDOWN
SQUARE 300

; Main walking paths
PENUP
SETXY -150 0
SETPENCOLOR 150 110 70
PENDOWN
PATH 300
PENUP
SETXY 0 -110
SETPENCOLOR 150 110 70
PENDOWN
SETHEADING 90
PATH 220

; Four garden beds around the central plaza
PENUP
SETXY -112 58
SETHEADING 0
PENDOWN
GARDEN_BED 48
PENUP
SETXY 64 58
SETHEADING 0
PENDOWN
GARDEN_BED 48
PENUP
SETXY -112 -100
SETHEADING 0
PENDOWN
GARDEN_BED 48
PENUP
SETXY 64 -100
SETHEADING 0
PENDOWN
GARDEN_BED 48

; Central learning pavilion and radial plaza
PENUP
SETXY -34 -34
SETHEADING 0
PENDOWN
SETPENCOLOR 60 125 210
HEXAGON 38
SETPENCOLOR 245 205 65
REPEAT 12 [FORWARD 28 BACK 28 RIGHT 30]

; Tree circles in the north and south corners
PENUP
SETXY -125 94
PENDOWN
SETPENCOLOR 35 145 95
TREE 2.8
PENUP
SETXY 109 94
PENDOWN
TREE 2.8
PENUP
SETXY -125 -92
PENDOWN
TREE 2.8
PENUP
SETXY 109 -92
PENDOWN
TREE 2.8

PRINT "Map complete: paths, beds, pavilion, and four trees"
